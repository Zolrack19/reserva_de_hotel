-- triggers
CREATE OR REPLACE FUNCTION asignar_valores_hotel()
RETURNS TRIGGER AS $$
BEGIN
  IF TG_OP = 'INSERT' THEN
    NEW.imagen_url := 'h' || NEW.id;
    NEW.nombre_normalizado := unaccent(NEW.nombre);
  
  ELSIF TG_OP = 'UPDATE' THEN
    IF NEW.nombre <> OLD.nombre THEN
      NEW.nombre_normalizado := unaccent(NEW.nombre);    --
    END IF;
  END IF;
  
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_hotel
BEFORE INSERT OR UPDATE ON hotel
FOR EACH ROW
EXECUTE FUNCTION asignar_valores_hotel();


CREATE OR REPLACE FUNCTION asignar_codigo_boleta()
RETURNS TRIGGER AS $$
BEGIN
  UPDATE boleta
  SET codigo = 'BO:' || LPAD(NEW.id::TEXT, 5, '0')
  WHERE id = NEW.id;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_codigo_boleta
AFTER INSERT ON boleta
FOR EACH ROW
EXECUTE FUNCTION asignar_codigo_boleta();


CREATE OR REPLACE FUNCTION asignar_valores_cuarto()
RETURNS TRIGGER AS $$
DECLARE 
  num_cuartos INTEGER;
BEGIN
  
  SELECT h.total_cuartos INTO num_cuartos FROM hotel h where h.id = NEW.hotel_id;
  
  NEW.numero := num_cuartos + 1;
  NEW.imagen_url := 'c' || NEW.id;
  
  UPDATE hotel
  SET total_cuartos = NEW.numero
  WHERE id = NEW.hotel_id;
  
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_cuarto
BEFORE INSERT ON cuarto
FOR EACH ROW
EXECUTE FUNCTION asignar_valores_cuarto();


-- funcion auxiliar
CREATE OR REPLACE FUNCTION public.hoteles_aleatorios(cantidad integer)
RETURNS SETOF hotel
LANGUAGE plpgsql
AS $$
DECLARE
  id_array integer[];
BEGIN
  SELECT array_agg(id) 
  INTO id_array 
  FROM (
    SELECT id 
    FROM hotel 
    ORDER BY random() 
    LIMIT cantidad
  ) sub;

  RETURN QUERY
  SELECT * 
  FROM hotel 
  WHERE id = ANY(id_array);
END;
$$;


