<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<ScrollPane hbarPolicy="NEVER" fitToWidth="true" fitToHeight="true"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <content>
      <VBox fillWidth="true" spacing="20" VBox.vgrow="ALWAYS">
         <children>

            <HBox prefHeight="242.0" style="-fx-background-color: red;" VBox.vgrow="ALWAYS"
                  maxWidth="Infinity" HBox.hgrow="ALWAYS">
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </HBox>

            <HBox prefHeight="242.0" style="-fx-background-color: red;" VBox.vgrow="ALWAYS"
                  maxWidth="Infinity" HBox.hgrow="ALWAYS">
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </HBox>

         </children>
      </VBox>
   </content>
</ScrollPane>
