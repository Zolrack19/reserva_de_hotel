<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" stylesheets="@../css/inicio.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hotel.controller.InicioController">
   <content>
      <HBox fx:id="principal" fillHeight="false" prefHeight="720.0" prefWidth="980.0">
      	<children>
      		<Region maxWidth="250.0" minWidth="-Infinity" prefHeight="612.0" prefWidth="70.0" HBox.hgrow="ALWAYS" />
      		<VBox alignment="CENTER" prefWidth="858.0" HBox.hgrow="ALWAYS">
      			<children>
      				<Region minHeight="-Infinity" prefHeight="60.0" prefWidth="980.0" />
      				<Button fx:id="btnInfoCuenta" mnemonicParsing="false" onAction="#irACuenta" prefHeight="40.0" prefWidth="122.0" styleClass="btnBuscarInicio" text="Mi usuario" />
      				<VBox minHeight="159.0" prefHeight="191.0" prefWidth="840.0">
      					<children>
      						<Label style="-fx-text-fill: #d0d0e0;" text="ENCUENTRA TU PRÓXIMA INSTANCIA">
      							<font>
      								<Font name="System Bold" size="24.0" />
      							</font>
      							<VBox.margin>
      								<Insets bottom="10.0" />
      							</VBox.margin>
      						</Label>
      						<HBox alignment="CENTER_LEFT" minWidth="840.0" prefHeight="62.0" prefWidth="840.0">
      							<children>
      								<TextField fx:id="txtBuscar" maxWidth="500.0" prefHeight="42.0" prefWidth="372.0" promptText="La ciudad de tus sueños te espera" styleClass="txtInicio" HBox.hgrow="ALWAYS">
      									<HBox.margin>
      										<Insets right="10.0" />
      									</HBox.margin>
      								</TextField>
      								<DatePicker fx:id="dateInicio" editable="false" maxWidth="250.0" prefHeight="26.0" prefWidth="161.0" HBox.hgrow="ALWAYS">
      									<HBox.margin>
      										<Insets right="10.0" />
      									</HBox.margin>
      								</DatePicker>
      								<DatePicker fx:id="dateFin" editable="false" maxWidth="250.0" prefHeight="26.0" prefWidth="161.0" HBox.hgrow="ALWAYS" />
      								<Region minWidth="62.0" prefHeight="62.0" prefWidth="62.0" HBox.hgrow="SOMETIMES" />
      								<Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarHotel" prefHeight="40.0" prefWidth="122.0" styleClass="btnBuscarInicio" text="Buscar">
      									<HBox.margin>
      										<Insets />
      									</HBox.margin>
      								</Button>
      							</children>
      							<padding>
      								<Insets left="10.0" />
      							</padding>
      						</HBox>
      					</children>
      				</VBox>
      				<ScrollPane hbarPolicy="NEVER" minHeight="257.0" prefHeight="350.0" prefWidth="750.0" vbarPolicy="NEVER">
      					<content>
      						<HBox fx:id="hboxCarusel" minHeight="-Infinity" prefHeight="348.0" spacing="20">
      							<padding>
      								<Insets right="22.0" />
      							</padding>
      						</HBox>
      					</content>
      					<VBox.margin>
      						<Insets left="55.0" right="55.0" top="10.0" />
      					</VBox.margin>
      				</ScrollPane>
      			</children>
      		</VBox>
      		<Region maxWidth="250.0" minWidth="-Infinity" prefHeight="612.0" prefWidth="70.0" HBox.hgrow="ALWAYS" />
      	</children>
      </HBox>
   </content>
</ScrollPane>
