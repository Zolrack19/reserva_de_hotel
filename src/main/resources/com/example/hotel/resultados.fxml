<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" stylesheets="@../css/inicio.css" vbarPolicy="NEVER" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hotel.controlersFXML.ResultadosContr">
   <content>
      <HBox fx:id="principal" prefHeight="720.0" prefWidth="980.0">
         <children>
            <Region maxWidth="250.0" minWidth="-Infinity" prefHeight="200.0" prefWidth="70.0" HBox.hgrow="ALWAYS" />
            <VBox HBox.hgrow="ALWAYS">
               <children>
                  <Region minHeight="-Infinity" prefHeight="60.0" prefWidth="837.0" />
                  <Button fx:id="btnAtras" mnemonicParsing="false" onAction="#volverInicio" prefHeight="40.0" prefWidth="122.0" styleClass="btnBuscarInicio" text="Atras" />
                  <HBox alignment="CENTER_LEFT" minWidth="840.0" prefHeight="62.0" prefWidth="840.0">
                     <children>
                        <TextField maxWidth="500.0" prefHeight="42.0" prefWidth="372.0" promptText="La ciudad de tus sueños te espera" styleClass="txtInicio" HBox.hgrow="ALWAYS">
                           <HBox.margin>
                              <Insets right="10.0" />
                           </HBox.margin>
                        </TextField>
                        <DatePicker maxWidth="200.0" prefHeight="26.0" prefWidth="161.0" HBox.hgrow="ALWAYS">
                           <HBox.margin>
                              <Insets right="10.0" />
                           </HBox.margin>
                           <tooltip>
                              <Tooltip text="Fecha de entrada" />
                           </tooltip>
                        </DatePicker>
                        <DatePicker maxWidth="200.0" prefHeight="26.0" prefWidth="161.0" HBox.hgrow="ALWAYS">
                           <tooltip>
                              <Tooltip text="Fecha de salida" />
                           </tooltip>
                        </DatePicker>
                        <Region maxWidth="120.0" minWidth="62.0" prefHeight="62.0" prefWidth="62.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscar" prefHeight="40.0" prefWidth="122.0" styleClass="btnBuscarInicio" text="Buscar">
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
                  <HBox maxHeight="1.7976931348623157E308" prefWidth="840.0">
                     <children>
                        <VBox maxHeight="-Infinity" minWidth="250.0" prefHeight="250.0" prefWidth="256.0" style="-fx-border-color: white;" />
                        <Region prefHeight="268.0" prefWidth="50.0" />
                        <VBox prefWidth="532.0" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox prefHeight="300.0" prefWidth="100.0" styleClass="caruselCard" />
                           </children>
                        </VBox>
                     </children>
                     <VBox.margin>
                        <Insets top="15.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
            <Region maxWidth="250.0" minWidth="-Infinity" prefHeight="200.0" prefWidth="70.0" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </content>
</ScrollPane>
